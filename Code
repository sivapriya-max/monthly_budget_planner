import tkinter as tk
from tkinter import messagebox

# Variables
income = 0
expenses = []

# Functions
def save_income():
    global income
    try:
        income = int(income_entry.get())
        messagebox.showinfo("Success", "Income saved!")
        update_summary()
    except:
        messagebox.showerror("Error", "Enter valid income")

def add_expense():
    try:
        amount = int(expense_entry.get())
        category = category_entry.get()

        if category == "":
            messagebox.showerror("Error", "Enter category")
            return

        expenses.append((amount, category))
        expense_entry.delete(0, tk.END)
        category_entry.delete(0, tk.END)

        update_summary()
    except:
        messagebox.showerror("Error", "Enter valid expense")

def update_summary():
    total_expense = sum([exp[0] for exp in expenses])
    balance = income - total_expense

    total_label.config(text=f"Total Expense: ₹{total_expense}")
    balance_label.config(text=f"Balance: ₹{balance}")

    # Category summary
    category_text.delete("1.0", tk.END)
    categories = {}

    for amount, cat in expenses:
        categories[cat] = categories.get(cat, 0) + amount

    for cat, amt in categories.items():
        category_text.insert(tk.END, f"{cat}: ₹{amt}\n")

# GUI Window
root = tk.Tk()
root.title("Monthly Budget Planner")
root.geometry("350x450")

# Income
tk.Label(root, text="Enter Income").pack()
income_entry = tk.Entry(root)
income_entry.pack()

tk.Button(root, text="Save Income", command=save_income).pack(pady=5)

# Expense
tk.Label(root, text="Enter Expense").pack()
expense_entry = tk.Entry(root)
expense_entry.pack()

tk.Label(root, text="Category").pack()
category_entry = tk.Entry(root)
category_entry.pack()

tk.Button(root, text="Add Expense", command=add_expense).pack(pady=5)

# Summary
total_label = tk.Label(root, text="Total Expense: ₹0")
total_label.pack()

balance_label = tk.Label(root, text="Balance: ₹0")
balance_label.pack()

tk.Label(root, text="Category-wise Summary").pack()
category_text = tk.Text(root, height=10)
category_text.pack()

# Run app
root.mainloop()
